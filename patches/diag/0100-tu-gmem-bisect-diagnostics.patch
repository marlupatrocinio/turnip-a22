+static const char *
+tu_gmem_shape_spec(void)
+{
+   static const char *spec = []() -> const char * {
+      const char *s = os_get_option("TU_GMEM_SHAPE");
+      return (s && *s) ? strdup(s) : NULL;
+   }();
+   return spec;
+}
+
+static bool
+tu_gmem_shape_field(const char *s, size_t n, uint32_t value)
+{
+   if (n == 1 && s[0] == '*')
+      return true;
+   char buf[16];
+   if (n == 0 || n >= sizeof(buf))
+      return false;
+   memcpy(buf, s, n);
+   buf[n] = '\0';
+   return strtoul(buf, NULL, 10) == value;
+}
+
+enum {
+   TU_DIAG_OCCL = 1 << 0,
+   TU_DIAG_PRED = 1 << 1,
+   TU_DIAG_CONDW = 1 << 2,
+   TU_DIAG_IABAR = 1 << 3,
+   TU_DIAG_SPM = 1 << 4,
+   TU_DIAG_SEC = 1 << 5,
+   TU_DIAG_SR = 1 << 6,
+   TU_DIAG_LRZ = 1 << 7,
+};
+
+static const struct { const char *name; uint32_t bit; } tu_diag_flag_names[] = {
+   { "occl", TU_DIAG_OCCL }, { "pred", TU_DIAG_PRED }, { "condw", TU_DIAG_CONDW },
+   { "iabar", TU_DIAG_IABAR }, { "spm", TU_DIAG_SPM }, { "sec", TU_DIAG_SEC },
+   { "sr", TU_DIAG_SR }, { "lrz", TU_DIAG_LRZ },
+};
+
+static bool
+tu_gmem_shape_conds(const char *s, size_t n, uint32_t flags)
+{
+   while (n > 0) {
+      size_t c = 0;
+      while (c < n && s[c] != '/')
+         c++;
+      if (c >= 2 && (s[0] == '+' || s[0] == '!')) {
+         for (unsigned i = 0; i < ARRAY_SIZE(tu_diag_flag_names); i++) {
+            size_t len = strlen(tu_diag_flag_names[i].name);
+            if (c - 1 == len && !strncmp(s + 1, tu_diag_flag_names[i].name, len)) {
+               bool has = flags & tu_diag_flag_names[i].bit;
+               if ((s[0] == '+') != has)
+                  return false;
+            }
+         }
+      }
+      s += c;
+      n -= c;
+      if (n > 0) {
+         s++;
+         n--;
+      }
+   }
+   return true;
+}
+
+static bool
+tu_gmem_shape_match(const char *spec, uint32_t w, uint32_t h, uint32_t att,
+                    uint32_t tiles, uint32_t flags, bool *geometry_match)
+{
+   const char *s = spec;
+   bool any_geom = false;
+   bool full = false;
+   while (*s) {
+      size_t n = strcspn(s, ",;");
+      size_t g = 0;
+      while (g < n && s[g] != '/')
+         g++;
+      bool geom;
+      if (g == 8 && !strncmp(s, "multibin", 8)) {
+         geom = tiles > 1;
+      } else {
+         const uint32_t vals[3] = { w, h, att };
+         const char *f = s;
+         const char *end = s + g;
+         geom = true;
+         for (int i = 0; i < 3 && geom; i++) {
+            const char *x = (const char *)memchr(f, 'x', end - f);
+            size_t fl = (i < 2 && x) ? (size_t)(x - f) : (size_t)(end - f);
+            if (i < 2 && !x)
+               geom = false;
+            else
+               geom = tu_gmem_shape_field(f, fl, vals[i]);
+            f += fl + 1;
+         }
+      }
+      if (geom) {
+         any_geom = true;
+         if (g == n || tu_gmem_shape_conds(s + g + 1, n - g - 1, flags))
+            full = true;
+      }
+      s += n;
+      if (*s)
+         s++;
+   }
+   if (geometry_match)
+      *geometry_match = any_geom;
+   return full;
+}
+
+static void
+tu_gmem_shape_log(uint32_t w, uint32_t h, uint32_t att, uint32_t flags,
+                  uint32_t draws, bool gmem)
+{
+   static struct { uint32_t w, h, att, flags; uint64_t count; } combos[64];
+   static uint32_t ncombo;
+   for (uint32_t i = 0; i < ncombo; i++) {
+      if (combos[i].w == w && combos[i].h == h && combos[i].att == att &&
+          combos[i].flags == flags) {
+         uint64_t c = ++combos[i].count;
+         if ((c & (c - 1)) == 0)
+            mesa_logw("TU_GMEM_SHAPE combo %ux%ux%u flags 0x%02x seen %" PRIu64 " times",
+                      w, h, att, flags, c);
+         return;
+      }
+   }
+   if (ncombo < ARRAY_SIZE(combos)) {
+      combos[ncombo] = { w, h, att, flags, 1 };
+      ncombo++;
+      char names[96] = "";
+      for (unsigned i = 0; i < ARRAY_SIZE(tu_diag_flag_names); i++) {
+         if (flags & tu_diag_flag_names[i].bit) {
+            strcat(names, " ");
+            strcat(names, tu_diag_flag_names[i].name);
+         }
+      }
+      mesa_logw("TU_GMEM_SHAPE new combo %ux%ux%u flags 0x%02x [%s ] draws %u -> %s",
+                w, h, att, flags, names, draws, gmem ? "gmem" : "sysmem");
+   }
+}
