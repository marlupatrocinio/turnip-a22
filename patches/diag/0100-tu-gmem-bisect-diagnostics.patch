+static void
+tu_diag_feedback_check(struct tu_cmd_buffer *cmd)
+{
+   static const bool logging = []() {
+      const char *s = os_get_option("TU_FEEDBACK_CHECK");
+      bool on = s && *s && *s != '0';
+      if (on)
+         mesa_logw("TU_FEEDBACK_CHECK enabled (memory-overlap detection)");
+      return on;
+   }();
+   static const bool mitigate = []() {
+      const char *s = os_get_option("TU_FEEDBACK_SYSMEM");
+      bool on = s && *s && *s != '0';
+      if (on)
+         mesa_logw("TU_FEEDBACK_SYSMEM enabled: passes with feedback loops use sysmem");
+      return on;
+   }();
+   static struct { const void *image; uint32_t att; } seen[128];
+   static uint32_t seen_count;
+   static uint64_t hits;
+
+   if ((!logging && !mitigate) || !cmd->state.pass || !cmd->state.attachments)
+      return;
+   const struct tu_descriptor_state *ds =
+      &cmd->descriptors[VK_PIPELINE_BIND_POINT_GRAPHICS];
+   const struct tu_framebuffer *fb = cmd->state.framebuffer;
+   for (uint32_t s = 0; s < MAX_SETS; s++) {
+      const struct tu_descriptor_set *set = ds->sets[s];
+      if (!set)
+         continue;
+      for (uint32_t i = 0; i < set->diag_image_count; i++) {
+         const struct tu_image *img = set->diag_images[i].image;
+         if (!img)
+            continue;
+         for (uint32_t a = 0; a < cmd->state.pass->attachment_count; a++) {
+            const struct tu_image_view *att = cmd->state.attachments[a];
+            if (!att || !att->image)
+               continue;
+            const struct tu_image *ai = att->image;
+            bool same = ai == img;
+            bool overlap = img->iova && ai->iova &&
+                           img->iova < ai->iova + ai->total_size &&
+                           ai->iova < img->iova + img->total_size;
+            if (!same && !overlap)
+               continue;
+            bool input = set->diag_images[i].input_attachment;
+            if (mitigate && !input && !cmd->state.rp.disable_gmem) {
+               cmd->state.rp.disable_gmem = true;
+               cmd->state.rp.force_render_mode_reason = "undeclared feedback loop";
+            }
+            if (!logging)
+               continue;
+            hits++;
+            bool known = false;
+            for (uint32_t k = 0; k < seen_count; k++)
+               known |= seen[k].image == img && seen[k].att == a;
+            if (!known && seen_count < ARRAY_SIZE(seen)) {
+               seen[seen_count].image = img;
+               seen[seen_count].att = a;
+               seen_count++;
+               mesa_logw("TU_FEEDBACK hit #%u: %s fb %ux%u att_count %u attachment %u "
+                         "att_format %d sampled_format %d image %ux%u set %u offset %u "
+                         "fs %.16s gmem_shape_pass %d",
+                         seen_count, input ? "input-attachment" : same ? "same-image" : "ALIAS",
+                         fb ? fb->width : 0, fb ? fb->height : 0,
+                         cmd->state.pass->attachment_count, a, (int)ai->vk.format,
+                         (int)img->vk.format,
+                         img->vk.extent.width, img->vk.extent.height, s,
+                         set->diag_images[i].offset,
+                         cmd->state.program.stage_blake3[MESA_SHADER_FRAGMENT],
+                         (int)(fb && fb->width == 1280 && fb->height == 720 &&
+                               cmd->state.pass->attachment_count == 7));
+            }
+            if ((hits & (hits - 1)) == 0)
+               mesa_logw("TU_FEEDBACK total hits %" PRIu64 " (distinct %u)", hits,
+                         seen_count);
+         }
+      }
+   }
+}
