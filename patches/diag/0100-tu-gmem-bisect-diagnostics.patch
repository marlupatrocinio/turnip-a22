 static void
+tu_diag_note_image(struct tu_descriptor_set *set, const uint32_t *dst,
+                   const VkDescriptorImageInfo *image_info, VkDescriptorType type)
+{
+   if (!set || !set->mapped_ptr || !image_info || image_info->imageView == VK_NULL_HANDLE)
+      return;
+   VK_FROM_HANDLE(tu_image_view, iview, image_info->imageView);
+   uint32_t offset = (uint32_t)(dst - set->mapped_ptr);
+   for (uint32_t i = 0; i < set->diag_image_count; i++) {
+      if (set->diag_images[i].offset == offset) {
+         set->diag_images[i].image = iview->image;
+         set->diag_images[i].input_attachment = type == VK_DESCRIPTOR_TYPE_INPUT_ATTACHMENT;
+         return;
+      }
+   }
+   if (set->diag_image_count < ARRAY_SIZE(set->diag_images)) {
+      set->diag_images[set->diag_image_count].offset = offset;
+      set->diag_images[set->diag_image_count].image = iview->image;
+      set->diag_images[set->diag_image_count].input_attachment =
+         type == VK_DESCRIPTOR_TYPE_INPUT_ATTACHMENT;
+      set->diag_image_count++;
+   }
+}
